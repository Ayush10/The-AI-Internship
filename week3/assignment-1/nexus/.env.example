# Nexus Multi-Agent Support — Environment Variables

# Google AI (for ADK agents)
GOOGLE_API_KEY=AI...
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=sbp_...

# MCP (Supabase MCP server connection)
# For Supabase Cloud: https://mcp.supabase.com/mcp?project_ref={ref}&features=database
# For self-hosted: http://localhost:{port} (run @supabase/mcp-server-supabase locally)
SUPABASE_MCP_URL=https://mcp.supabase.com/mcp

# Returns A2A Service
RETURNS_A2A_URL=http://localhost:8001

# App
BASE_PATH=
